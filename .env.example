# Blitz.cloud injects PORT automatically — do NOT hardcode. Server reads process.env.PORT.
PORT=3000
HOST=0.0.0.0

# OPTIONAL: kunci proxy dengan username + password.
# Kalau DIISI KEDUANYA: client wajib kirim Proxy-Authorization (atau URL user:pass@host).
# Kalau DIKOSONGKAN: proxy terbuka untuk siapa saja (default, paling gampang).
PROXY_USER=
PROXY_PASS=
