# Blitz.cloud injects PORT automatically — do NOT hardcode. Server reads process.env.PORT.
PORT=3000
HOST=0.0.0.0

# Pool: koma/newline/semicolon separated. Supported BOTH formats:
#   protocol://user:pass@host:port   -> http://u:p@1.2.3.4:8080 | socks5://u:p@1.2.3.4:1080
#   host:port:user:pass               -> 1.2.3.4:8080:u:p
#   host:port                         -> 1.2.3.4:8080 (no auth)
# Protocol: http, https, socks4, socks5, socks5h
# Option A: inline env (paling gampang di dashboard blitz.cloud)
#PROXIES=http://u:p@1.2.3.4:8080,socks5://u:p@5.6.7.8:1080,9.9.9.9:8080:u:p

# Option B: file (kalau deploy via git, isi relay/proxies.txt)
PROXY_FILE=proxies.txt

# Rotasi: roundrobin | random
ROTATE=roundrobin

# Timeout upstream (ms). 0 = TANPA BATAS — wajib untuk long request / SSE / LLM stream
UPSTREAM_TIMEOUT_MS=0
# Timeout handshake CONNECT ke upstream proxy (ms)
CONNECT_TIMEOUT_MS=20000

# URL default untuk POST /api/check
CHECK_URL=http://httpbin.org/ip

# Cooldown & retry upstream gagal
PROXY_COOLDOWN_MS=60000
PROXY_MAX_FAILS=3
